# To use AI Studio (Free Tier or Paid):
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# To use Vertex AI (to use Google Cloud Credits):
# Leave GEMINI_API_KEY blank.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Supabase (For async job status management)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Security Settings
ENABLE_API_DOCS=true
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
MAX_PHOTOS_PER_BATCH=10

# Model configuration (change if needed)
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash
GEMINI_GENERATION_MODEL=gemini-3.1-flash-image
